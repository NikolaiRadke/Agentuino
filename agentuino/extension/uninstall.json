{
  "name": "Agentuino",
  "version": "1.2.1",
  "directories": [
    "~/.agentuino",
    "{tmp}/agentuino-debug"
  ],
  "files": [
    "~/.arduinoIDE/extensions/agentuino.vsix",
    "~/.arduinoIDE/deployedPlugins/agentuino"
  ],
  "globalState": [],
  "settings": [
    "agentuino.language",
    "agentuino.agent",
    "agentuino.compileCheck",
    "agentuino.permissionMode",
    "agentuino.gitignoreAll",
    "agentuino.claudePath",
    "agentuino.claudeModel",
    "agentuino.codexPath",
    "agentuino.codexModel",
    "agentuino.vibePath",
    "agentuino.vibeModel",
    "agentuino.antigravityPath",
    "agentuino.antigravityModel",
    "agentuino.opencodePath",
    "agentuino.opencodeModel",
    "agentuino.arduinoCliPath",
    "agentuino.checkForUpdates",
    "agentuino.skipUpdateVersion",
    "agentuino.skipConfigVersion"
  ],
  "confirm": {
    "enabled": true,
    "double": false
  }
}
